% Minimal texmf.cnf for pdfTeX on Android.
% The app must set env: TEXMFROOT=<extracted texmf dir>, TEXMFCNF=<dir containing this file>

TEXMFDIST    = $TEXMFROOT/texmf-dist
TEXMFVAR     = $TEXMFROOT/texmf-var
TEXMFSYSVAR  = $TEXMFVAR
TEXMF        = {$TEXMFVAR,$TEXMFDIST}
TEXMFDBS     = $TEXMF

TEXINPUTS    = .:$TEXMF/tex/{latex,generic,}//
TEXFORMATS   = $TEXMFROOT/fmt
TEXPOOL      = $TEXMFROOT/fmt
TFMFONTS     = $TEXMF/fonts/tfm//
VFFONTS      = $TEXMF/fonts/vf//
T1FONTS      = $TEXMF/fonts/type1//
ENCFONTS     = $TEXMF/fonts/enc//
TEXFONTMAPS  = $TEXMF/fonts/map/{pdftex,dvips,}//
TEXPSHEADERS = $TEXMF/{dvips,fonts/enc}//
TEXCONFIG    = $TEXMF/dvips//
TEXMFSCRIPTS = $TEXMF/scripts//

% Never try to run mktex* helper scripts (not present on Android)
MKTEXTFM = 0
MKTEXPK  = 0
MKTEXMF  = 0
MKTEXTEX = 0
MKTEXFMT = 0

% Safety / behaviour
openout_any = p
openin_any  = a
shell_escape = f
parse_first_line = f
file_line_error_style = t
TEXMFOUTPUT =

% Memory (generous defaults for phones)
main_memory = 5000000
extra_mem_top = 0
extra_mem_bot = 0
font_mem_size = 8000000
font_max = 9000
hash_extra = 600000
pool_size = 6250000
string_vacancies = 90000
max_strings = 500000
pool_free = 47500
buf_size = 200000
nest_size = 500
max_in_open = 15
param_size = 10000
save_size = 100000
stack_size = 10000
error_line = 79
half_error_line = 50
max_print_line = 79
hyph_size = 8191
trie_size = 1000000
expand_depth = 10000
